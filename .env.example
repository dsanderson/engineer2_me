# Copy to .env for local runs: `cp .env.example .env` then fill in what you need.
# .env is gitignored. The process environment always wins over this file, so
# `ONSHAPE_ACCESS_KEY=other uv run python main.py` still overrides it for one run.
# Point somewhere else with E2_ENV_FILE=/path/to/secrets.env.
#
# For the Docker stack, use deploy/.env instead — compose reads that one.

# --- Onshape (optional) -----------------------------------------------------
# Key pair from https://dev-portal.onshape.com/keys, used as HTTP Basic.
# Without them CAD items still store and render; only verification is disabled.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
# E2_ONSHAPE_BASE=https://cad.onshape.com

# --- the rest, all optional -------------------------------------------------
# E2_DATA_DIR=./data
# E2_BASE_URL=http://localhost:8000
# E2_RUNNER_URL=http://localhost:8001
# E2_PORT=8000
# E2_RUN_TIMEOUT_S=30
# Set E2_PASSWORD to make the app enforce HTTP Basic itself (no Caddy in front).
# E2_USER=agent
# E2_PASSWORD=
