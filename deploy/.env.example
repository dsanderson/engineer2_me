# Copy to deploy/.env and edit. Every variable the stack reads is listed here.

# --- where the site lives ---------------------------------------------------
# localhost                → Caddy issues its own internal cert (run `caddy trust` once),
#                            or just use http://localhost and skip TLS.
# engineer2.example.com    → automatic Let's Encrypt. Point the DNS record here first.
E2_SITE_ADDRESS=localhost
E2_BASE_URL=http://localhost
E2_HTTP_PORT=80
E2_HTTPS_PORT=443

# --- the one shared credential ----------------------------------------------
# Agents use it as HTTP Basic: httpx.get(url, auth=("agent", "<the plaintext password>"))
# Produce the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
E2_USER=agent
E2_PASSWORD_HASH=

# --- storage ----------------------------------------------------------------
# Mounted at /data in the app container. Backup is `tar czf backup.tgz data/`.
E2_DATA_HOST_DIR=../data
# The app runs as this uid:gid so it can write the mounted directory.
# Use your own: `id -u` and `id -g`. Leave unset only if the directory is owned by 10001.
E2_UID=1000
E2_GID=1000

# --- runner -----------------------------------------------------------------
E2_RUN_TIMEOUT_S=30
E2_RUNNER_MEM=1g

# --- Onshape (optional) -----------------------------------------------------
# Without these, CAD items still store and render; only verification is disabled.
# Create an API key pair at https://dev-portal.onshape.com/keys
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
E2_ONSHAPE_BASE=https://cad.onshape.com
